{
  "expo": {
    "name": "blocks",
    "slug": "blocks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/icon.png",
    "scheme": "blocks",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icon/icon.png",
      "bundleIdentifier": "com.koljasam.blocks"
    },
    "android": {
      "package": "com.koljasam.blocks",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/adaptive-icon.png",
        "backgroundColor": "#DD2E44"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["SCHEDULE_EXACT_ALARM", "POST_NOTIFICATIONS", "VIBRATE"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icon/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/icon/icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/icon/icon.png",
            "imageWidth": 96
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon/notification-icon.png",
          "color": "#000000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
